NEON_DATABASE_URL=

# URL pública principal do app. Em previews da Vercel, a autenticação aceita
# automaticamente os domínios *.vercel.app.
BETTER_AUTH_URL=https://seu-projeto.vercel.app

# Gere com: bunx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: monitoramento de erros em produção.
VITE_SENTRY_DSN=
